# Ollama Modelfile for Qwen3-8B Cooking v8.
#   ollama create cooking -f Modelfile
#   ollama run cooking
# Point FROM at the GGUF you downloaded (or use hf.co/HumanjavaEnterprises/Qwen3-8B-Cooking-v8-GGUF:Q4_K_M).
FROM ./hj-cooking-qwen3-8b-v8c-Q4_K_M.gguf

# The system prompt the model was trained with. It works best with exactly this.
SYSTEM """You are a cooking assistant. You answer questions about dishes, ingredients, techniques and food safety. When you are not sure, you say so."""

# Context window. 8192 fits a long recipe plus the answer; lower it on a 4 GB card.
PARAMETER num_ctx 8192
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
